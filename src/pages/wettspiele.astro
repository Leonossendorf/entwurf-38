---
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import Text from '../components/Text.astro';
import Bild from '../components/Bild.astro';
import bilder from '../data/bilder.json';
import Kontaktformular from '../components/Kontaktformular.astro';
const plaene = [
  { name: 'plan-captains-becher-2026', titel: 'Captains-Becher 2026' },
  { name: 'plan-rosen-pokal-2026', titel: 'Rosen Pokal 2026' },
  { name: 'plan-team-cup-2026', titel: 'Team-Cup 2026' },
];
const gross = (n: string) => { const b = (bilder as any)[n]; return `/bilder/${n}-${b.breiten[b.breiten.length - 1]}.webp`; };
---
<Basis titel="Wettspiele" beschreibung="Lochspielserien im Golfclub Euregio: Captains-Becher, Rosen Pokal und Team-Cup.">
  <Seitenkopf titel="Wettspiele" text="Lochspielserien über die ganze Saison: Captains-Becher, Rosen Pokal und Team-Cup." bild="winterpokal" bildAlt="" bereich={{ titel: 'Club' }} />
  <section class="abschnitt">
    <div class="innen">
      <Text name="wettspiele" />
      <ul class="plaene">
        {plaene.map((p) => (
          <li>
            <button type="button" class="plan-knopf" data-gross={gross(p.name)} data-alt={`Turnierplan ${p.titel}`} data-text={p.titel}>
              <span class="foto" style="display:block"><Bild name={p.name} alt={`Turnierplan ${p.titel}`} sizes="(max-width: 900px) 100vw, 30vw" /></span>
              <span class="plan-knopf__titel">{p.titel}<span>Groß ansehen</span></span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="abschnitt abschnitt--weiss"><div class="innen innen--schmal"><Kontaktformular titel="Frage zu den Wettspielen" themen={['Wettspiele', 'Allgemeine Frage']} /></div></section>
</Basis>

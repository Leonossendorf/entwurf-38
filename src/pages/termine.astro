---
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import Termine from '../components/Termine.astro';
import Symbol from '../components/Symbol.astro';
import club from '../data/club.json';
---
<Basis titel="Termine" beschreibung="Alle Termine des Golfclub Euregio an einem Ort: Turniere, Damen- und Herrengolf, Kurse, Einsteiger-Angebote, Clubleben und Restaurant.">
  <Seitenkopf titel="Alle Termine" text="Turniere, Damen- und Herrengolf, Kurse, Feste und das Restaurant an einer Stelle. Wählen Sie oben aus, was Sie interessiert." bild="clubmeisterschaft-flight" bildAlt="" />
  <section class="abschnitt">
    <div class="innen zwei-spalten zwei-spalten--termine">
      <Termine filter id="alle-termine" />
      <aside aria-label="Anmeldung und Ergebnisse">
        <div class="karte" style="position:sticky;top:7rem">
          <h2 class="fahne" style="font-size:1.3rem">Anmelden und Ergebnisse</h2>
          <p>Anmelden, Startlisten und Ergebnisse finden Sie in PC CADDIE oder in der PC-CADDIE-App.</p>
          <ul class="haken">
            <li><a href={club.pccaddie.turniere} rel="noopener">Turnierkalender und Anmeldung</a></li>
            <li><a href={club.pccaddie.startlisten} rel="noopener">Startlisten</a></li>
            <li><a href={club.pccaddie.ergebnisse} rel="noopener">Ergebnisse</a></li>
            <li><a href={club.pccaddie.startzeit} rel="noopener">Startzeit buchen</a></li>
          </ul>
          <p class="leise" style="margin:0"><Symbol name="kalender" /> Mit „In meinen Kalender“ speichern Sie einen Termin direkt in Ihrem Handy- oder Computerkalender.</p>
        </div>
      </aside>
    </div>
  </section>
</Basis>

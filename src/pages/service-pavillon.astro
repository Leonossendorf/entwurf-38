---
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import Text from '../components/Text.astro';
import Bild from '../components/Bild.astro';
import Symbol from '../components/Symbol.astro';
import Kontaktformular from '../components/Kontaktformular.astro';
import z from '../data/oeffnungszeiten.json';
import p from '../data/personen.json';
import club from '../data/club.json';
---
<Basis titel="Service-Pavillon" beschreibung="Service-Pavillon des Golfclub Euregio: Anmeldung, Startzeiten, Shop, Fitting und Öffnungszeiten.">
  <Seitenkopf titel="Service-Pavillon" text="Anmeldung, Startzeiten, Shop und Fitting: Ihr erster Weg auf der Anlage." bild="shop-bekleidung" bildAlt="" position="50% 20%" bereich={{ titel: 'Spielen' }} />
  <section class="abschnitt">
    <div class="innen zwei-spalten">
      <div>
        <Text name="service-pavillon" />
        <div class="knopfreihe">
          <a class="knopf knopf--voll" href="#fitting">Fitting-Termin buchen</a>
          <a class="knopf knopf--rand" href={`https://wa.me/${club.whatsappService.replace('+', '')}`} rel="noopener"><Symbol name="whatsapp" />WhatsApp</a>
          <a class="knopf knopf--rand" href={`tel:${club.telefonLink}`}><Symbol name="telefon" />{club.telefon}</a>
        </div>
        <p style="margin-top:1rem"><a href={`mailto:${club.mailService}`}>{club.mailService}</a></p>
      </div>
      <div class="tabelle-huelle" tabindex="0">
        <table>
          <caption>Öffnungszeiten</caption>
          <tbody>{z.servicePavillon.tage.map((t) => <tr data-tag={t.tag}><th scope="row">{t.tag}</th><td>{t.zeit}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>
  <section class="abschnitt abschnitt--weiss" id="fitting" aria-labelledby="fitting-titel">
    <div class="innen zwei-spalten zwei-spalten--mitte">
      <div>
        <p class="dachzeile">Schläger passend machen</p>
        <h2 class="fahne" id="fitting-titel">Fitting bei Jörg Fehlhaber</h2>
        <p>Beim Fitting werden Ihre Schläger auf Ihren Schwung abgestimmt. Jörg Fehlhaber berät zu Material und wechselt nach Absprache auch Schlägergriffe.</p>
        <p>Freie Fitting-Termine sehen und buchen Sie jetzt direkt online in PC CADDIE: Tag wählen, freie Uhrzeit antippen, fertig.</p>
        <div class="knopfreihe">
          <a class="knopf knopf--voll" href={club.pccaddie.fitting} rel="noopener">Freie Fitting-Termine ansehen</a>
          <a class="knopf knopf--rand" href={`tel:${club.telefonLink}`}><Symbol name="telefon" />{club.telefon}</a>
        </div>
        <p class="leise" style="margin-top:1rem">Regelmäßig gibt es außerdem Fitting-Demotage verschiedener Schlägermarken. Die Termine stehen unter <a href="/termine/">Termine</a>.</p>
      </div>
      {(() => { const j = p.service.find((m) => m.name === 'Jörg Fehlhaber'); return j && j.bild && <figure class="foto foto--hoch" style="max-width:22rem;justify-self:center"><Bild name={j.bild} alt="Porträt von Jörg Fehlhaber" sizes="(max-width: 900px) 80vw, 22rem" position="50% 25%" /></figure>; })()}
    </div>
  </section>
  <section class="abschnitt" aria-labelledby="team-titel">
    <div class="innen">
      <h2 class="fahne" id="team-titel">Das Team</h2>
      <div class="raster raster--3">
        {p.service.map((m) => (
          <div class="karte" style="display:grid;grid-template-columns:5rem 1fr;gap:1rem;align-items:center">
            {m.bild ? <div class="foto foto--quadrat" style="border-radius:50%"><Bild name={m.bild} alt={`Porträt von ${m.name}`} sizes="5rem" position="50% 30%" /></div> : <div class="foto foto--quadrat" style="border-radius:50%;display:grid;place-items:center;background:var(--petrol);color:#fff;font-family:var(--schrift-titel);font-weight:800;font-size:1.4rem" aria-hidden="true">{m.name.split(' ').map((x) => x[0]).join('')}</div>}
            <div><strong>{m.name}</strong>{m.text && <p class="leise" style="margin:.3rem 0 0">{m.text}</p>}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="abschnitt"><div class="innen innen--schmal"><Kontaktformular titel="Frage an den Service-Pavillon" vorwahl="service" /></div></section>
</Basis>
